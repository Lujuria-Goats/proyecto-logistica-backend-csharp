# Database Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=apexvision;Username=postgres;Password=YOUR_PASSWORD

# JWT Configuration
Jwt__Key=YOUR_SECRET_KEY_HERE_MUST_BE_AT_LEAST_32_CHARACTERS
Jwt__Issuer=ApexVision
Jwt__Audience=ApexVisionUsers
Jwt__ExpirationMinutes=60

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Cloudinary Configuration
Cloudinary__CloudName=YOUR_CLOUD_NAME
Cloudinary__ApiKey=YOUR_API_KEY
Cloudinary__ApiSecret=YOUR_API_SECRET
